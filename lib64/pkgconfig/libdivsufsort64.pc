prefix=/apex/org.blisslabs.ag.libdivsufsort
exec_prefix=${prefix}
libdir=/apex/org.blisslabs.ag.libdivsufsort/lib
includedir=/apex/org.blisslabs.ag.libdivsufsort/include

Name: libdivsufsort64
Description: A lightweight suffix sorting library
Version: 2.0.2-1
URL: https://github.com/y-256/libdivsufsort
Libs: -L${libdir} -ldivsufsort64
Cflags: -I${includedir}
